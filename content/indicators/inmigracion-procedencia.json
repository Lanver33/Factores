{
  "id": "inmigracion-procedencia",
  "kind": "immigration-flow",
  "category": "pensions-demography",
  "question": {
    "es": "¿Cuál es la evolución de la inmigración procedente del extranjero en España?",
    "en": "What is the evolution of immigration from abroad into Spain?"
  },
  "unit": {
    "es": "personas",
    "en": "people"
  },
  "valueFormat": "number",
  "contextNotes": {
    "es": [
      "Flujo anual de inmigraciones procedentes del extranjero registrado por el Instituto Nacional de Estadística (INE).",
      "Combina la serie histórica 2008-2020 (Tabla 24295) y la serie actual 2021-2024 (Tabla 69690) de la Estadística de Migraciones y Cambios de Residencia (EMCR).",
      "Incluye el desglose individual de los 52 países de mayor flujo hacia España y la agregación por macro-regiones continentales."
    ],
    "en": [
      "Annual immigration flows from abroad registered by the National Statistics Institute (INE).",
      "Combines historical series 2008-2020 (Table 24295) and current series 2021-2024 (Table 69690) from the Migration and Residence Changes Statistics (EMCR).",
      "Includes granular breakdown for 52 top origin countries and continental macro-regions."
    ]
  },
